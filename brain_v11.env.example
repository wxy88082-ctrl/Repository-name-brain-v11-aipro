# Brain V11 recommended paper config
TRADING_MODE=paper
BRAIN_WS=./brain_v11_data
AI_DECISION_MODE=rule
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SCORE_THRESHOLD=80
V11_MIN_EXEC_SCORE=84
V11_MIN_EXEC_RR=1.9
V11_SETUP_WHITELIST=pullback,breakout
ENABLE_TREND_SETUP=0
V11_ALLOW_ALT_BREAKOUT=0
RISK_PER_TRADE=0.003
MAX_POSITIONS=1
MAX_NEW_ENTRIES_PER_CYCLE=1
LEVERAGE=2
REQUIRE_BACKTEST_QUALITY_GATE=0
GLOBAL_KILL_SWITCH=0
NO_NEW_TRADES=0

# Research gate thresholds
V11_MIN_RESEARCH_TRADES=120
V11_MIN_EXPECTANCY_R=0.03
V11_MIN_PROFIT_FACTOR=1.12
V11_MAX_DRAWDOWN_R=25
V11_MAX_RISK_OF_RUIN=0.05

# Demo/live extra safety
USE_EXCHANGE_PROTECTION=1
LIVE_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
LIVE_MAX_ORDER_NOTIONAL=50
V11_LIVE_MAJOR_ONLY=1

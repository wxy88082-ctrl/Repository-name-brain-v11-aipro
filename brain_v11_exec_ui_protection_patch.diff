+    def _set_pending(self, symbol: str, enabled: bool) -> None:
+        # Subclasses with persistent state can override through self.state/self.store.
+        if not hasattr(self, "state") or not isinstance(getattr(self, "state"), dict):
+            return
+        st = getattr(self, "state")
+        pending = set(st.get("pending_symbols", []) or [])
+        if enabled:
+            pending.add(symbol)
+        else:
+            pending.discard(symbol)
+        st["pending_symbols"] = sorted(pending)
+        try:
+            getattr(self, "store").save(st)
+        except Exception:
+            pass
+
+    def _is_pending(self, symbol: str) -> bool:
+        if not hasattr(self, "state") or not isinstance(getattr(self, "state"), dict):
+            return False
+        return symbol in set(getattr(self, "state").get("pending_symbols", []) or [])
+
+    def _record_cooldown(self, symbol: str) -> None:
+        if not hasattr(self, "state") or not isinstance(getattr(self, "state"), dict):
+            return

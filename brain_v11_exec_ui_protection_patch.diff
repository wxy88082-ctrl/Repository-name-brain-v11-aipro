+        cooldowns = dict(st.get("cooldowns", {}) or {})
+        cooldowns[symbol] = (utc_now() + dt.timedelta(minutes=self.settings.cooldown_minutes)).isoformat()
+        st["cooldowns"] = cooldowns
+        try:
+            getattr(self, "store").save(st)
+        except Exception:
